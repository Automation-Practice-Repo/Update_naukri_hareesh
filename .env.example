# Environment configuration for Naukri tests
# Copy this file to .env and fill in your credentials
# IMPORTANT: Keep .env file secure - never commit it to version control

# Naukri credentials
NAUKRI_URL=https://www.naukri.com/
NAUKRI_USERNAME=your_email@example.com
NAUKRI_PASSWORD=your_password_here

# Test execution settings
HEADLESS=false
TIMEOUT=30000

# Telegram notification settings (recommended - simple setup)
# Enable Telegram notifications
TELEGRAM_ENABLED=false
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get chat ID from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# Email notification settings (optional - more complex setup)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
# For Gmail: Use App Password instead of regular password
# Enable 2FA on your Gmail account and generate an App Password
